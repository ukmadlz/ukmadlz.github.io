---
layout: layouts/base.njk
permalink: /blog/index.html
title: Blog
---

<div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-8">{{ title }}</h1>

    <section class="space-y-6">
        {% for post in posts %}
        <article class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow">
            <a href="/blog/{{ post.slug }}/" class="block p-6">
                <div class="flex flex-col md:flex-row gap-4">
                    {% if post.image %}
                    <div class="flex-shrink-0">
                        <img src="{{ post.image }}" alt="{{ post.title }}" class="w-full md:w-48 h-32 object-cover rounded-lg">
                    </div>
                    {% endif %}
                    <div class="flex-grow">
                        <h2 class="text-xl font-semibold text-gray-900 hover:text-blue-600 transition-colors mb-2">
                            {{ post.title }}
                        </h2>
                        <time datetime="{{ post.published_date }}" class="text-sm text-gray-500">
                            {{ post.published_date | date("MMMM D, YYYY") }}
                        </time>
                        {% if post.excerpt %}
                        <p class="mt-3 text-gray-600 line-clamp-2">{{ post.excerpt }}</p>
                        {% endif %}
                    </div>
                </div>
            </a>
        </article>
        {% else %}
        <div class="bg-white rounded-lg shadow-sm p-8 text-center">
            <p class="text-gray-600">No blog posts yet. Check back soon!</p>
        </div>
        {% endfor %}
    </section>
</div>
