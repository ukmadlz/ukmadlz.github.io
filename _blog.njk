---
layout: layouts/base.njk
pagination:
    data: posts
    size: 1
    alias: post
permalink: "blog/{{ post.slug }}/index.html"
eleventyComputed:
    title: "{{ post.title }}"
---

<article class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-8">{{ post.title }}</h1>

    <section class="bg-white rounded-lg shadow-sm p-8 mb-8">
        <div class="flex flex-col md:flex-row gap-8">
            {% if post.image %}
            <div class="flex-shrink-0">
                <img src="{{ post.image }}" alt="{{ post.title }}" class="w-full md:w-48 h-48 object-cover rounded-xl">
            </div>
            {% endif %}
            <div class="flex-grow">
                <div class="flex items-center gap-4 text-gray-500 mb-4">
                    <time datetime="{{ post.published_date }}" class="text-sm">
                        {{ post.published_date | date("MMMM D, YYYY") }}
                    </time>
                </div>
                {% if post.origin %}
                <p class="text-sm text-gray-600">
                    Originally published on
                    <a href="{{ post.origin }}" target="_blank" rel="noopener noreferrer" class="text-blue-600 font-medium hover:underline">
                        {{ post.origin | hostname }}
                    </a>
                </p>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="bg-white rounded-lg shadow-sm p-8">
        <div class="blog-content">
            {{ post.content | safe }}
        </div>
    </section>

    <footer class="mt-8">
        <a href="/blog/" class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 transition-colors font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to all posts
        </a>
    </footer>
</article>
